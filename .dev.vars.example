# The Discord app information
APP_ID=<YOUR_APP_ID>
DISCORD_TOKEN=<YOUR_BOT_TOKEN>
PUBLIC_KEY=<YOUR_PUBLIC_KEY>

# Your Discord server, and the channel for go-live messages
GUILD_ID=<YOUR_SERVER_ID>
LIVE_CHANNEL_ID=<YOUR_CHANNEL_ID>

# From https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=<YOUR_TWITCH_CLIENT_ID>
TWITCH_CLIENT_SECRET=<YOUR_TWITCH_CLIENT_SECRET>
# The channel name from twitch.tv/<name>
TWITCH_LOGIN=<TWITCH_CHANNEL_NAME>

# Fine-grained token for this repo with Contents: read & write, used to start the VOD upload workflow
GITHUB_TOKEN=<YOUR_GITHUB_TOKEN>

# The role created by Discord's Twitch integration
TWITCH_SUB_ROLE_ID=<TWITCH_INTEGRATION_ROLE_ID>
# The role the bot gives to subscribers
SUBSCRIBER_ROLE_ID=<YOUR_ROLE_ID>
